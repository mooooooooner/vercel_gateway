# 服务监听端口
PORT=8787

# 管理后台访问令牌（前端登录 + /api 管理接口鉴权）。留空则不鉴权（不推荐）。
ADMIN_TOKEN=change-me-admin-token

# 客户端调用 /v1 代理时需要携带的 API Key（Authorization: Bearer <这里>）。
# 可用英文逗号分隔配置多个。留空则代理接口不校验（任何人可用）。
PROXY_API_KEYS=sk-your-proxy-key

# Vercel AI Gateway 上游地址（一般无需修改）
GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1

# 余额/额度查询地址（一般无需修改）
GATEWAY_CREDITS_URL=https://ai-gateway.vercel.sh/v1/credits

# 判定"额度不足"的阈值（美元），低于该值视为不足
LOW_BALANCE_THRESHOLD=0.01

# Debug 模式：开启后记录每次代理的 key 选择、上游状态、重试等详细日志。
# 可选 1/true/on。也可在前端「运行日志」页随时开关。
DEBUG=false
